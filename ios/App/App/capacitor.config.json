{
	"appId": "online.sendkiss.app",
	"appName": "KISS",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"url": "https://app.sendkiss.online",
		"cleartext": false,
		"allowNavigation": [
			"app.sendkiss.online",
			"*.sendkiss.online",
			"192.168.*.*",
			"10.*.*.*",
			"localhost"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"backgroundColor": "#070707",
			"androidScaleType": "CENTER_CROP"
		},
		"CapacitorCookies": {
			"enabled": true
		},
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"PushNotificationsPlugin",
		"CapacitorContactsPlugin"
	]
}
