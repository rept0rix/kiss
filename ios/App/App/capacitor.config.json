{
	"appId": "online.sendkiss.app",
	"appName": "KISS",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1200,
			"backgroundColor": "#070707",
			"androidScaleType": "CENTER_CROP"
		},
		"CapacitorCookies": {
			"enabled": true
		},
		"CapacitorHttp": {
			"enabled": true
		}
	},
	"packageClassList": [
		"AppPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"CapacitorContactsPlugin"
	]
}
