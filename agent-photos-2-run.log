0]?.trim() ?? \"\";\n    if (!/^[a-z0-9.-]+(:\\d+)?$/i.test(host)) return \"\";\n    const local = /^(localhost|127\\.|0\\.0\\.0\\.0|\\[::1\\])/i.test(host);\n    const proto = (req.headers.get(\"x-forwarded-proto\") ?? \"\").split(\",\")[0]?.trim() || (local ? \"http\" : \"https\");\n    return `${proto === \"http\" ? \"http\" : \"https\"}://${host}`;\n  } catch {\n    return \"\";\n  }\n});\n\nexport const getShareCard = createServerFn({ method: \"GET\" })\n  .validator((code: string) => code)\n  .handler(async ({ data: raw }): Promise<string | null> => {\n    const code = raw.trim().toLowerCase().slice(0, 8);\n    if (!/^[a-z0-9]{4,8}$/.test(code)) return null;\n    const sql = await getSql();\n    try {\n      const stored = await sql<{ body: string }>`\n        select body from share_cards where code = ${code} limit 1\n      `;\n      if (stored[0]?.body?.startsWith(\"data:image\")) return stored[0].body;\n    } catch {\n      /* table missing */\n    }\n    try {\n      const rows = await sql<{ card: string | null; from_phone: string | null; from_name: string }>`\n        select card, from_phone, from_name from share_links where code = ${code}\n      `;\n      const row = rows[0];\n      if (row?.card?.startsWith(\"data:image\")) return row.card;\n      if (!row) {\n        const qr = await qrCodeOwner(sql, code);\n        return qr ? await findPhoto(sql, qr.phone, null) : null;\n      }\n      const photo = await findPhoto(sql, row.from_phone ?? null, row.from_name ?? null);\n      return photo;\n    } catch {\n      return null;\n    }\n  });\n\nfunction bookPerson(\n  phone: string,\n  displayName: string,\n  lastSeen?: string | null,\n  photo?: string | null,\n): PublicPerson {\n  return {\n    userId: `p:${phone}`,\n    handle: phone.slice(-4),\n    displayName: displayName || phone,\n    avatarHue: Math.abs(hashCode(phone)) % 360,\n    lastSeen: lastSeen ?? null,\n    phone,\n    photo: photo || null,\n  };\n}\n\nexport const registerPhone = createServerFn({ method: \"POST\" })\n  .validator((data: { phone: string; name?: string; photo?: string | null }) => data)\n  .handler(async ({ data }) => {\n    const raw = normalizePhone(data.phone);\n    if (raw.length < MIN_PHONE_DIGITS || raw.length > MAX_PHONE_DIGITS) {\n      throw new Error(\"Need a real phone number\");\n    }\n    const name = (data.name ?? \"\").trim().slice(0, 32);\n    const rawPhoto = data.photo ?? \"\";\n    if (rawPhoto.length > MAX_PROFILE_PHOTO_CHARS) throw new Error(\"Photo is too big\");\n    const photo = rawPhoto.startsWith(\"data:image\") ? rawPhoto : null;\n    const sql = await getSql();\n    // Re-registering a number that is already in the book under another\n    // spelling (missing country code, short QA form) updates that row instead","isEmpty":false,"exceededLimit":false,"totalLines":1688,"fileSize":59735,"path":"/Users/naoryanko/kiss/kiss/src/lib/kisses/server.ts","readRange":{"startLine":1060,"endLine":1169},"relatedCursorRulePaths":[],"relatedCursorRules":[]}}},"hookAdditionalContexts":[],"toolCallId":"toolu_01JzBhTSbt6hE7s5mPEjB4ui","startedAtMs":"1790664081262","completedAtMs":"1790664083199"},"model_call_id":"a1b67bc5-7b24-4ca5-a450-eb657272fd3b-0-5gin","session_id":"5d8046c4-f2b3-4249-9034-da1b847ddf76","timestamp_ms":1790664088792}
