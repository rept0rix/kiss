 padding: 0.75rem 0.85rem 0.65rem;\n}\n\n.sheet-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n}\n\n.sheet-x {\n  height: 2.75rem;\n  padding: 0 0.5rem;\n  color: var(--color-muted);\n  font-size: 0.875rem;\n}\n\n.sheet-actions {\n  position: sticky;\n  bottom: 0;\n  margin-top: 0.75rem;\n  padding-top: 0.5rem;\n  background: var(--color-surface);\n}\n\nbody.sheet-open {\n  overflow: hidden;\n}\n\n.kiss-preview {\n  border: 1px solid var(--color-border);\n  background: var(--color-elevated);\n  border-radius: var(--radius-lg);\n  padding: 0.85rem 1rem;\n}\n\n.hit-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n}\n\n.hit {\n  display: grid;\n  width: 100%;\n  grid-template-columns: auto 1fr auto;\n  align-items: center;\n  column-gap: 0.75rem;\n  border-radius: var(--radius-md);\n  background: var(--color-elevated);\n  padding: 0.7rem 0.85rem;\n  text-align: left;\n}\n\n.hit-face {\n  width: 2.4rem;\n  height: 2.4rem;\n  object-fit: cover;\n  border-radius: 999px;\n}\n\n.hit-copy {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n}\n\n.hit-name {\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n  font-weight: 600;\n}\n\n.hit-meta {\n  font-size: 0.75rem;\n  color: var(--color-muted);\n}\n\n.hit-go {\n  font-family: var(--font-display);\n  font-size: 0.85rem;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--color-primary);\n}\n\n.live-dot {\n  display: inline-block;\n  width: 0.5rem;\n  height: 0.5rem;\n  border-radius: 999px;\n  background: #3ee07a;\n}\n\n.live-row {\n  display: flex;\n  width: min(22rem, 92vw);\n  gap: 0.4rem;\n  overflow-x: auto;\n  margin-top: 0.7rem;\n  padding-bottom: 0.15rem;\n}\n\n.live-pill {\n  position: relative;\n  flex: 0 0 auto;\n  height: 2rem;\n  padding: 0 0.75rem;\n  border-radius: 999px;\n  background: var(--color-elevated);\n  font-size: 0.8rem;\n}\n\n.flood-row {\n  display: flex;\n  gap: 0.35rem;\n  padding