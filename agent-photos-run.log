stify-content: center;\n  border-radius: var(--radius-xl);\n  background: var(--color-primary);\n  color: var(--color-primary-fg);\n  font-family: var(--font-display);\n  font-size: 1.125rem;\n  letter-spacing: -0.03em;\n  text-transform: uppercase;\n}\n\n.send-wa.is-off {\n  pointer-events: none;\n  opacity: 0.4;\n}\n\n.who-row {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.face-pick {\n  display: grid;\n  width: 3rem;\n  height: 3rem;\n  flex: 0 0 auto;\n  place-items: center;\n  overflow: hidden;\n  border-radius: 999px;\n  border: 1px solid var(--color-border);\n  background: var(--color-elevated);\n  color: var(--color-muted);\n  font-size: 1.25rem;\n}\n\n.face-pick img {\n  width: 3rem;\n  height: 3rem;\n  object-fit: cover;\n}\n\n.phone-row .phone-pick {\n  height: 3rem;\n  flex: 0 0 auto;\n  padding-inline: 1rem;\n}\n\n.recent-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n}\n\n.send-link.is-off {\n  opacity: 0.4;\n}\n\n.recent-chip {\n  height: 2.25rem;\n  border-radius: 999px;\n  border: 1px solid var(--color-border);\n  background: var(--color-elevated);\n  padding: 0 0.75rem;\n  font-size: 0.8rem;\n  color: var(--color-fg);\n}\n\n.catch-name {\n  font-family: var(--font-display);\n  font-size: clamp(2.2rem, 10vw, 3.2rem);\n  line-height: 0.95;\n  letter-spacing: -0.04em;\n  text-transform: none;\n}\n\n@media (max-width: 767px) {\n  .fly-kiss { opacity: 0.28; }\n  .fly-heart { opacity: 0.22; }\n}\n\n@media (min-width: 768px) {\n  .orbit-photo,\n  .orbit-empty {\n    width: 8.5rem;\n    height: 8.5rem;\n  }\n  .name-line { font-size: 2.2rem; }\n}\n\n\n\n.burst {\n  position: fixed;\n  inset: 0;\n  z-index: 50;\n  pointer-events: none;\n}\n\n.burst-bit {\n  position: absolute;\n  left: 50%;\n  top: 40%;\n  width: 2.5rem;\n  color: var(--color-primary);\n  animation: burst-fly 1.15s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n.burst-1 { --x: -9rem; --y: -13rem; }\n.burst-2 { --x: 8rem; --y: -12rem; }\n.burst-3 { --x: -2rem; --y: -16rem; }\n.burst-4 { --x: 11rem; --y: -6rem; }\n.burst-5 { --x: -12rem; --y: -4rem; }\n.burst-6 { --x: 3rem; --y: -14rem; }\n.burst-7 { --x: -7rem; --y: 6rem; }\n.burst-8 { --x: 9rem; --y: 7rem; }\n.burst-9 { --x: -14rem; --y: 2rem; }\n.burst-10 { --x: 13rem; --y: 1rem; }\n.burst-11 { --x: -4rem; --y: 10rem; }\n.burst-12 { --x: 5rem; --y: 11rem; }\n.burst-13 { --x: -10rem; --y: -9rem; }\n.burst-14 { --x: 10rem; --y: -10rem; }\n.burst-15 { --x: 0rem; --y: -18rem; }\n.burst-16 { --x: -1rem; --y: 13rem; }\n\n@keyframes burst-fly {\n  from {\n    transform: translate(-50%, -50%) scale(0.5) rotate(0deg);\n    opacity: 1;\n  }\n  to {\n    transform: translate(var(--x), var(--y)) scale(1.05) rotate(200deg);\n    opacity: 0;\n  }\n}\n\n@keyframes chip-pulse {\n  0%,\n  100% { transform: scale(1); opacity: 1; }\n  50% { transform: scale(1.14); opacity: 0.75; }\n}\n\n.live-kiss {\n  position: fixed;\n  inset: 0;\n  z-index: 90;\n  display: grid;\n  place-items: center;\n  background: rgb(7 7 7 / 0.92);\n}\n\n.love-rain {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.love-drop {\n  position: absolute;\n  top: -8%;\n  color: var(--color-primary);\n  animation: love-fall linear infinite;\n}\n\n.love-drop svg {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n@keyframes love-fall {\n  0% {\n    transform: translateY(0) rotate(0deg) scale(0.5);\n    opacity: 0;\n  }\n  12% { opacity: 1; }\n  100% {\n    transform: translateY(115vh) rotate(var(--spin, 20deg)) scale(1.2);\n    opacity: 0;\n  }\n}\n\n.love-glow {\n  box-shadow: 0 0 0 5px var(--color-primary), 0 0 80px rgb(225 29 46 / 0.55);\n  animation: live-pop 0.55s cubic-bezier(0.22, 1, 0.36, 1) both, love-pulse 1.6s ease-in-out 0.5s infinite;\n}\n\n@keyframes love-pulse {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.06); }\n}\n\n.live-love-line {\n  margin-top: 0.35rem;\n  color: #ff8a96;\n  font-size: 0.95rem;\n}\n\n.live-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  padding: 1.5rem;\n}\n\n.live-face {\n  position: relative;\n  display: grid;\n  width: 12rem;\n  height: 12rem;\n  place-items: center;\n  padding: 0;\n  background: transparent;\n  border-radius: 999px;\n  animation: live-pop 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n.count-bit {\n  position: absolute;\n  width: 1.7rem;\n  color: var(--color-primary);\n  pointer-events: none;\n  animation: count-pop 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n.count-bit svg {\n  width: 1.7rem;\n  height: auto;\n}\n\n.live-count {\n  margin-top: 0.35rem;\n  font-family: var(--font-display);\n  font-size: 1.15rem;\n  letter-spacing: -0.03em;\n  color: var(--color-primary);\n}\n\n@keyframes count-pop {\n  from { transform: translate(-50%, -50%) scale(0.2); opacity: 0; }\n  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }\n}\n\n.live-face img,\n.live-face .face-init {\n  width: 12rem;\n  height: 12rem;\n  object-fit: cover;\n  border-radius: 999px;\n  font-size: 3rem;\n}\n\n.live-stamp {\n  position: absolute;\n  right: -0.4rem;\n  bottom: -0.2rem;\n  width: 3.2rem;\n  color: var(--color-primary);\n  animation: live-stamp 0.7s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n.live-kicker {\n  margin-top: 1.1rem;\n  font-size: 0.75rem;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--color-primary);\n}\n\n.live-name {\n  margin-top: 0.35rem;\n  font-family: var(--font-display);\n  font-size: 2rem;\n  letter-spacing: -0.04em;\n  text-transform: uppercase;\n}\n\n.live-sub {\n  margin-top: 0.2rem;\n  color: var(--color-muted);\n}\n\n.live-go {\n  margin-top: 1.25rem;\n  height: 3.5rem;\n  width: min(16rem, 80vw);\n  border-radius: var(--radius-xl);\n  background: var(--color-primary);\n  color: var(--color-primary-fg);\n  font-family: var(--font-display);\n  font-size: 1.35rem;\n  letter-spacing: -0.03em;\n  text-transform: uppercase;\n}\n\n.live-skip {\n  margin-top: 0.5rem;\n  height: 2.75rem;\n  color: var(--color-muted);\n  font-size: 0.95rem;\n}\n\n@keyframes live-pop {\n  from { transform: scale(0.4); opacity: 0; }\n  to { transform: scale(1); opacity: 1; }\n}\n\n@keyframes live-stamp {\n  from { transform: scale(2.2) rotate(-24deg); opacity: 0; }\n  to { transform: scale(1) rotate(-8deg); opacity: 1; }\n}\n\n/* ── Desktop wide layout ───────────────────────────── */\n.stage-left,\n.stage-right {\n  display: contents;\n}\n\n@media (min-width: 1024px) {\n  .stage {\n    flex-direction: row;\n    align-items: center;\n    justify-content: center;\n    gap: 2.5rem;\n    padding-inline: 3rem;\n  }\n\n  .stage-left {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-end;\n    text-align: right;\n    flex: 1;\n    max-width: 22rem;\n    gap: 0.35rem;\n  }\n\n  .stage-right {\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    flex: 1;\n    max-width: 22rem;\n    gap: 1rem;\n    justify-content: flex-end;\n  }\n\n  .stage .orbit {\n    order: 2;\n    width: 28rem;\n    height: 28rem;\n    max-height: 78dvh;\n    margin-top: 0;\n    flex: 0 0 auto;\n  }\n\n  .stage-left { order: 1; }\n  .stage-right { order: 3; }\n\n  .orbit-photo,\n  .orbit-empty {\n    width: 9rem;\n    height: 9rem;\n  }\n\n  .orbit-chip { width: 5.2rem; }\n  .chip-face,\n  .chip-photo,\n  .chip-initials,\n  .chip-face .face-init { width: 5rem; height: 5rem; }\n\n  .name-line { font-size: 2rem; }\n\n  .counts { margin-top: 0.4rem; font-size: 0.9rem; }\n  .phone-line { font-size: 0.85rem; }\n\n  .live-row {\n    flex-direction: column;\n    width: 100%;\n    gap: 0.5rem;\n    overflow: visible;\n  }\n\n  .stage .dock {\n    margin-top: auto;\n    max-width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .fly-kiss,\n  .fly-heart,\n  .kiss-enter,\n  .kiss-ring,\n  .burst-bit,\n  .boot-bit {\n    animation: none;\n    opacity: 0.5;\n  }\n}\n\n","afterFullFileContent":"@import \"tailwindcss\";\n@import \"./kiss-ui.css\";\n\n@theme {\n  --color-bg: #070707;\n  --color-surface: #121212;\n  --color-elevated: #1c1c1c;\n  --color-fg: #f3eee8;\n  --color-muted: #9b948c;\n  --color-subtle: #6d6760;\n  --color-primary: #e11d2e;\n  --color-primary-fg: #fff5f5;\n  --color-border: #2b2b2b;\n  --color-ring: #e11d2e;\n  --radius-xs: 0.25rem;\n  --radius-sm: 0.5rem;\n  --radius-md: 0.75rem;\n  --radius-lg: 1.25rem;\n  --radius-xl: 2rem;\n  --font-display: \"Archivo Black\", \"Impact\", sans-serif;\n  --font-sans: \"IBM Plex Sans\", \"Segoe UI\", system-ui, sans-serif;\n}\n\n@layer base {\n  html {\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    -webkit-text-size-adjust: 100%;\n    text-size-adjust: 100%;\n    touch-action: manipulation;\n    height: 100%;\n    overflow: hidden;\n  }\n\n  body {\n    background: var(--color-bg);\n    color: var(--color-fg);\n    font-family: var(--font-sans);\n    height: 100%;\n    overflow: hidden;\n    overscroll-behavior: none;\n  }\n\n  input,\n  textarea,\n  select {\n    font-size: 16px;\n  }\n\n  h1,\n  h2,\n  h3 {\n    font-family: var(--font-display);\n    text-wrap: balance;\n    letter-spacing: -0.04em;\n    text-transform: uppercase;\n  }\n\n  p {\n    text-wrap: pretty;\n  }\n\n  button:not(:disabled),\n  [role=\"button\"]:not(:disabled) {\n    cursor: pointer;\n  }\n}\n\n.storm-hero {\n  position: relative;\n  z-index: 10;\n  display: flex;\n  min-height: 100dvh;\n  flex-direction: column;\n  justify-content: flex-end;\n}\n\n@media (min-width: 768px) {\n  .storm-hero {\n    justify-content: center;\n  }\n}\n\n.app-header {\n  padding-top: max(0.75rem, env(safe-area-inset-top));\n}\n\n.app-nav {\n  padding-bottom: env(safe-area-inset-bottom);\n}\n\n.storm {\n  position: relative;\n  overflow: hidden;\n  isolation: isolate;\n  z-index: 0;\n  min-height: 100dvh;\n  background: var(--color-bg);\n}\n\n.storm-body {\n  position: relative;\n  z-index: 1;\n}\n\n.storm.is-quiet .fly-kiss,\n.storm.is-quiet .fly-heart {\n  display: none;\n}\n\n.storm-face {\n  position: absolute;\n  object-fit: cover;\n  border-radius: 999px;\n  box-shadow: 0 18px 50px rgb(0 0 0 / 0.55);\n  pointer-events: none;\n}\n\n.storm-face-1 { width: 42%; top: -6%; left: -12%; transform: rotate(-16deg); }\n.storm-face-2 { width: 34%; top: 4%; right: -10%; transform: rotate(12deg); }\n.storm-face-3 { width: 28%; top: 28%; left: -8%; transform: rotate(8deg); }\n.storm-face-4 { width: 36%; top: 38%; right: -14%; transform: rotate(-10deg); }\n.storm-face-5 { width: 22%; top: 58%; left: 6%; transform: rotate(-22deg); }\n.storm-face-6 { width: 30%; bottom: -8%; left: -6%; transform: rotate(14deg); }\n.storm-face-7 { width: 26%; bottom: 6%; right: 4%; transform: rotate(-8deg); }\n.storm-face-8 { width: 30%; top: 6%; left: 30%; transform: rotate(18deg); }\n.storm-face-9 { width: 26%; bottom: 18%; left: 36%; transform: rotate(-4deg); }\n.storm-face-10 { width: 24%; top: 0%; left: 52%; transform: rotate(22deg); }\n\n.fly-kiss {\n  position: absolute;\n  color: var(--color-primary);\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.35;\n}\n\n.fly-kiss-1 { width: 2.4rem; animation: kiss-fly-a 9s linear infinite; }\n.fly-kiss-2 { width: 1.8rem; animation: kiss-fly-b 11s linear infinite; animation-delay: -2s; }\n.fly-kiss-3 { width: 2.8rem; animation: kiss-fly-c 8s linear infinite; animation-delay: -4s; }\n.fly-kiss-4 { width: 1.6rem; animation: kiss-fly-a 10s linear infinite; animation-delay: -1.2s; }\n.fly-kiss-5 { width: 2.2rem; animation: kiss-fly-b 7s linear infinite; animation-delay: -3.4s; }\n.fly-kiss-6 { width: 1.9rem; animation: kiss-fly-c 12s linear infinite; animation-delay: -6s; }\n.fly-kiss-7 { width: 2.5rem; animation: kiss-fly-a 13s linear infinite; animation-delay: -5s; }\n.fly-kiss-8 { width: 1.5rem; animation: kiss-fly-b 9s linear infinite; animation-delay: -0.6s; }\n\n@keyframes kiss-fly-a {\n  0% { transform: translate3d(-15vw, 110vh, 0) rotate(-25deg); }\n  100% { transform: translate3d(110vw, -20vh, 0) rotate(40deg); }\n}\n\n@keyframes kiss-fly-b {\n  0% { transform: translate3d(110vw, 90vh, 0) rotate(20deg); }\n  100% { transform: translate3d(-20vw, -15vh, 0) rotate(-50deg); }\n}\n\n@keyframes kiss-fly-c {\n  0% { transform: translate3d(40vw, 120vh, 0) rotate(0deg); }\n  100% { transform: translate3d(10vw, -25vh, 0) rotate(80deg); }\n}\n\n@keyframes kiss-rise {\n  from {\n    opacity: 0;\n    transform: scale(0.96) translateY(8px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n@keyframes kiss-pulse {\n  0% {\n    transform: scale(1);\n    opacity: 0.35;\n  }\n  100% {\n    transform: scale(1.5);\n    opacity: 0;\n  }\n}\n\n.kiss-enter {\n  animation: kiss-rise 250ms cubic-bezier(0.22, 1, 0.36, 1) both;\n}\n\n.kiss-ring {\n  animation: kiss-pulse 700ms cubic-bezier(0.22, 1, 0.36, 1) infinite;\n}\n\n.fly-heart {\n  position: absolute;\n  color: var(--color-primary);\n  pointer-events: none;\n  z-index: 2;\n  opacity: 0.75;\n}\n\n.fly-heart-1 { width: 2.4rem; animation: kiss-fly-b 8s linear infinite; animation-delay: -1s; }\n.fly-heart-2 { width: 1.8rem; animation: kiss-fly-c 11s linear infinite; animation-delay: -3s; }\n.fly-heart-3 { width: 3rem; animation: kiss-fly-a 9.5s linear infinite; animation-delay: -5s; }\n.fly-heart-4 { width: 2rem; animation: kiss-fly-c 7.2s linear infinite; animation-delay: -2.4s; }\n.fly-heart-5 { width: 2.6rem; animation: kiss-fly-a 12s linear infinite; animation-delay: -7s; }\n.fly-heart-6 { width: 1.6rem; animation: kiss-fly-b 6.5s linear infinite; animation-delay: -0.8s; }\n\n.boot {\n  position: fixed;\n  inset: 0;\n  z-index: 100;\n  overflow: hidden;\n  background: #e11d2e;\n  transition: background 0.85s ease;\n}\n\n.boot.is-dark {\n  background: #070707;\n}\n\n.boot-word {\n  position: absolute;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  font-family: var(--font-display);\n  font-size: clamp(4rem, 22vw, 9rem);\n  letter-spacing: -0.07em;\n  color: #070707;\n  transition: color 0.85s ease;\n}\n\n.boot.is-dark .boot-word {\n  color: #e11d2e;\n}\n\n.boot-bit {\n  position: absolute;\n  pointer-events: none;\n}\n\n.boot-kiss {\n  color: #070707;\n}\n\n.boot-heart {\n  color: #e11d2e;\n}\n\n.boot-k-1, .boot-h-1 { width: 4.5rem; left: 8%; top: 12%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 0s; }\n.boot-k-2, .boot-h-2 { width: 3rem; right: 10%; top: 18%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 0.35s; }\n.boot-k-3, .boot-h-3 { width: 5.5rem; left: 18%; bottom: 16%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 0.7s; }\n.boot-k-4, .boot-h-4 { width: 2.4rem; right: 16%; bottom: 22%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 1.05s; }\n.boot-k-5, .boot-h-5 { width: 3.6rem; left: 42%; top: 8%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 1.4s; }\n.boot-k-6, .boot-h-6 { width: 2.8rem; left: 6%; top: 48%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 1.75s; }\n.boot-k-7, .boot-h-7 { width: 4rem; right: 8%; top: 52%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 2.1s; }\n.boot-k-8, .boot-h-8 { width: 3.2rem; left: 55%; bottom: 10%; animation: boot-pop 2.8s ease-in-out infinite; animation-delay: 2.45s; }\n\n@keyframes boot-pop {\n  0% { transform: scale(0.3); opacity: 0; }\n  15% { transform: scale(1.1); opacity: 1; }\n  35% { transform: scale(1); opacity: 1; }\n  65% { transform: scale(1); opacity: 1; }\n  100% { transform: scale(0.8); opacity: 0; }\n}\n\n.boot-meter {\n  position: absolute;\n  right: 1.5rem;\n  bottom: max(2rem, env(safe-area-inset-bottom));\n  left: 1.5rem;\n  z-index: 2;\n  display: grid;\n  gap: 0.45rem;\n}\n\n.boot-track {\n  height: 0.45rem;\n  overflow: hidden;\n  border-radius: 999px;\n  background: rgb(255 255 255 / 0.22);\n}\n\n.boot.is-dark .boot-track {\n  background: rgb(225 29 46 / 0.28);\n}\n\n.boot-fill {\n  display: block;\n  height: 100%;\n  border-radius: 9