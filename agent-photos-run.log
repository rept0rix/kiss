,{"lineNumber":38,"content":"import { SkinsStore } from \"@/components/skins-store\";","contentTruncated":false,"isContextLine":false},{"lineNumber":39,"content":"import { SuperKissStore } from \"@/components/super-kiss-store\";","contentTruncated":false,"isContextLine":false},{"lineNumber":138,"content":"  const serverOrbitData: Pick<HomePayload, \"inbox\" | \"sent\"> | undefined = home.data","contentTruncated":false,"isContextLine":false},{"lineNumber":141,"content":"  const serverOrbitReady = Boolean(home.data || phoneOrbit.isFetched);","contentTruncated":false,"isContextLine":false},{"lineNumber":230,"content":"    const hydratedOrbit = mergeOrbit(me.orbit, serverOrbitData, { trustServer: true });","contentTruncated":false,"isContextLine":false},{"lineNumber":347,"content":"    () => mergeOrbit(me.orbit, serverOrbitData, { trustServer: serverOrbitReady }),","contentTruncated":false,"isContextLine":false},{"lineNumber":348,"content":"    [me.orbit, serverOrbitData, serverOrbitReady],","contentTruncated":false,"isContextLine":false}]}],"totalLines":44,"totalMatchedLines":44,"clientTruncated":false,"ripgrepTruncated":false}}}}}},"hookAdditionalContexts":[],"toolCallId":"toolu_011BEQn68fPsZue9AQCo6nKm","startedAtMs":"1790662754869","completedAtMs":"1790662755322"},"model_call_id":"efcc917a-a88a-45b2-852e-f591dfa7e0c7-22-eyqr","session_id":"048e4607-7507-4c09-84b1-b33f77e5e581","timestamp_ms":1790662760985}
